# ==============================================================================
# AXION PackTech Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build and Compilation Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
*/.next/
*.tsbuildinfo
next-env.d.ts
.npm/

# Environment and Secret Files (NEVER commit secrets to Git)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production
*.env
!.env.example
!*/.env.example

# Credentials, Keys and Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Runtime & Local Uploads / Temp
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
temp/
tmp/
.temp/

# Logs and Debugging
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/
.pytest_cache/

# Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Vercel / Deployment
.vercel/
