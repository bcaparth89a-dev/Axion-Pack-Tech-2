# ==============================================================================
# AXION PackTech Frontend Environment Configuration Example
# ==============================================================================

# Server-Side Internal API URL (Used by Next.js Server Components & Route Handlers)
API_BASE_URL=http://localhost:5000/api/v1

# Client-Side Public API URL (Accessible from browser client components)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend Canonical Website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 Public Media CDN URL
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.yourdomain.com

# Cloudflare Turnstile Human Verification Site Key
# (Cloudflare official testing sitekey: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE2ruw7_63TybJHS    
TURNSTILE_SECRET_KEY=0x4AAAAAAE2ruzlY_tT5MW4gvHMpPufo5a8
