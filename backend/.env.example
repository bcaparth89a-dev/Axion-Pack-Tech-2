# ==============================================================================
# AXION PackTech Backend Environment Configuration Example
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Credentials & Database Setup
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_root_password
MONGO_INITDB_DATABASE=axion_packtech
MONGO_AUTH_SOURCE=admin

# MongoDB Connection (With connection pooling & authentication)
# Host Connection (for running scripts/dev directly on host machine):
MONGODB_URI=mongodb://127.0.0.1:27017/axion_packtech
# Docker Internal Connection (used by Docker Compose API service):
MONGODB_DOCKER_URI=mongodb://root:your_mongodb_root_password@mongodb:27017/axion_packtech?authSource=admin
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Redis Cache Connection
REDIS_URL=redis://localhost:6379

# Client & API URLs (CORS Security)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_key_change_in_production

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=axion-packtech-media
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.yourdomain.com

# Rate Limiting & Login Throttling
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900
MUTATION_RATE_LIMIT_MAX_REQUESTS=20

# Cloudflare Turnstile Human Verification (Backend Secret Key)
# (Cloudflare official testing secret: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SMTP Email Configuration (Brevo / Sendinblue / Generic SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_smtp_login
BREVO_SMTP_PASS=your_smtp_master_password
BREVO_FROM_NAME="AXION PackTech Machinery"
BREVO_FROM_EMAIL=no-reply@yourdomain.com
NOTIFICATION_EMAIL=admin@yourdomain.com

# Initial Admin Bootstrap (Optional for createAdmin script)
INITIAL_ADMIN_EMAIL=admin@axionpacktech.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=AXION SuperAdmin
